{
  "name": "@roomwave/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/web.ts",
    "dev:worker": "node --watch --env-file=.env src/worker.ts",
    "migrate": "node --env-file=.env src/tools/migrate.ts",
    "seed": "node --env-file=.env src/tools/seed.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@roomwave/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.3.15",
    "fastify": "^5.12.7",
    "ioredis": "^5.11.1",
    "kysely": "^0.29.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "assets"
  ]
}
