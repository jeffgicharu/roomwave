# Copy to .env for local development. Production settings live only on the server.
NODE_ENV=development
RELEASE=dev
HOST=127.0.0.1
PORT=8300
SITE_URL=http://localhost:5173
DATABASE_URL=postgres://roomwave:roomwave@127.0.0.1:5432/roomwave
DATABASE_POOL=6
REDIS_URL=redis://127.0.0.1:6390/3
# 32 or more random characters.
APP_SECRET=
# Optional: without it, emails are recorded as skipped and not sent.
RESEND_API_KEY=
# Creates the staff account on the first seed.
SEED_STAFF_PASSWORD=
