---
import { Image } from "astro:assets";

import { templateById } from "@roomwave/shared";

import { USE_CASES, type UseCase } from "../../data/use-cases.ts";
import Base from "../../layouts/Base.astro";
import { SITE } from "../../site.ts";

export function getStaticPaths() {
  return USE_CASES.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

interface Props {
  item: UseCase;
}

const { item } = Astro.props;
const template = templateById(item.template.id);
const others = USE_CASES.filter((u) => u.slug !== item.slug);

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Use cases", item: `${SITE.url}/use-cases` },
    { "@type": "ListItem", position: 2, name: item.name, item: `${SITE.url}/use-cases/${item.slug}` },
  ],
};
---

<Base title={item.name} description={item.description} path={`/use-cases/${item.slug}`} structuredData={[breadcrumbs]}>
  <section class="hero">
    <div class="container grid">
      <div class="copy">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/use-cases">Use cases</a> <span aria-hidden="true">/</span> <span aria-current="page">{item.name}</span></nav>
        <h1 class="h2">{item.title}</h1>
        <p class="lead">{item.lead}</p>
        <div class="cta">
          <a class="btn btn-signal btn-large" href="/try">Try it free, no sign-up</a>
        </div>
      </div>
      <div class="photo-frame hero-photo">
        <Image src={item.image} alt={item.alt} widths={[600, 900, 1300]} sizes="(min-width: 900px) 50vw, 100vw" format="webp" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section-tight problem">
    <div class="container">
      <p class="eyebrow">The problem</p>
      <p class="big">{item.problem}</p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <h2 class="h3 moments-title">How rooms like yours use it</h2>
      <ol class="moments">
        {
          item.moments.map((moment, index) => (
            <li>
              <span class="n">{String(index + 1).padStart(2, "0")}</span>
              <h3>{moment.title}</h3>
              <p>{moment.body}</p>
              <p class="example">
                <span>On the slide</span>“{moment.example}”
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {
    template && (
      <section class="section stage-band">
        <div class="container template">
          <div>
            <p class="eyebrow">Ready to use</p>
            <h2 class="h2">Start from “{template.name}”</h2>
            <p class="lead">{template.description} It opens in your workspace with {template.slides.length} slides, ready to present or change.</p>
          </div>
          <a class="btn btn-signal btn-large" href={`/try?template=${template.id}`}>Try it now</a>
        </div>
      </section>
    )
  }

  <section class="section-tight">
    <div class="container">
      <h2 class="h3">Other rooms</h2>
      <ul class="others">
        {
          others.map((o) => (
            <li>
              <a href={`/use-cases/${o.slug}`}>
                {o.name} <span aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding: clamp(40px, 6vw, 88px) 0 clamp(32px, 5vw, 64px);
    background: var(--paper);
    background-image: var(--grain);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 5vw, 72px);
  }

  .copy {
    display: grid;
    gap: 20px;
  }

  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.92rem;
    color: var(--ink-3);
  }

  .crumbs a {
    color: var(--ink-2);
  }

  h1 {
    font-size: clamp(2.2rem, 1.5rem + 3vw, 4.2rem);
  }

  .hero-photo {
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-3);
  }

  .problem {
    background: var(--paper-2);
  }

  .big {
    max-width: 30ch;
    margin-top: 14px;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .moments-title {
    margin-bottom: 28px;
  }

  .moments {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .moments li {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 10px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--card);
  }

  .n {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: var(--signal);
  }

  .moments h3 {
    font-size: 1.3rem;
  }

  .moments p {
    color: var(--ink-2);
  }

  .example {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--paper-2);
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink) !important;
  }

  .example span {
    font-family: var(--font-text);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .template {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
  }

  .template > div {
    display: grid;
    gap: 14px;
    max-width: 700px;
  }

  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .others a {
    display: inline-flex;
    padding: 12px 18px;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    font-weight: 600;
    text-decoration: none;
  }

  .others a:hover {
    border-color: var(--ink);
  }

  @media (max-width: 900px) {
    .grid,
    .moments {
      grid-template-columns: 1fr;
    }
  }
</style>
