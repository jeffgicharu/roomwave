---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page does not exist." path="/404">
  <section class="section lost">
    <div class="container inner">
      <p class="code" aria-hidden="true">404</p>
      <h1 class="h2">Nobody answered at this address.</h1>
      <p class="lead">The page may have moved, or the link may have a typing mistake.</p>
      <div class="links">
        <a class="btn btn-signal" href="/">Go to the home page</a>
        <a class="btn btn-ghost" href="/join">Join a session</a>
        <a class="btn btn-ghost" href="/help">Help centre</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .lost {
    min-height: 60vh;
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }

  .code {
    font-family: var(--font-display);
    font-size: clamp(5rem, 3rem + 10vw, 11rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.06em;
    color: var(--signal-strong);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 8px;
  }
</style>
