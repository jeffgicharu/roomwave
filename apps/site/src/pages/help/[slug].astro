---
import { getCollection, render, type CollectionEntry } from "astro:content";

import Base from "../../layouts/Base.astro";
import { SITE } from "../../site.ts";

export async function getStaticPaths() {
  const articles = (await getCollection("help")).sort((a, b) => a.data.order - b.data.order);
  return articles.map((article, index) => ({
    params: { slug: article.id },
    props: { article, next: articles[index + 1] ?? null, previous: articles[index - 1] ?? null },
  }));
}

interface Props {
  article: CollectionEntry<"help">;
  next: CollectionEntry<"help"> | null;
  previous: CollectionEntry<"help"> | null;
}

const { article, next, previous } = Astro.props;
const { Content } = await render(article);
const url = `${SITE.url}/help/${article.id}`;

const data = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Help centre", item: `${SITE.url}/help` },
      { "@type": "ListItem", position: 2, name: article.data.title, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: article.data.title,
    description: article.data.description,
    url,
    publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
  },
];
---

<Base title={article.data.title} description={article.data.description} path={`/help/${article.id}`} structuredData={data}>
  <article class="section-tight">
    <div class="container layout">
      <header class="head">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/help">Help centre</a> <span aria-hidden="true">/</span> <span>{article.data.section}</span></nav>
        <h1 class="h2">{article.data.title}</h1>
        <p class="lead">{article.data.description}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <nav class="pager" aria-label="More guides">
        {previous ? <a href={`/help/${previous.id}`}><span>Previous</span>{previous.data.title}</a> : <span />}
        {next && (
          <a class="next" href={`/help/${next.id}`}>
            <span>Next</span>
            {next.data.title}
          </a>
        )}
      </nav>
    </div>
  </article>
</Base>

<style>
  .layout {
    display: grid;
    gap: 32px;
    max-width: 820px;
  }

  .head {
    display: grid;
    gap: 16px;
    padding-top: clamp(16px, 4vw, 48px);
  }

  .crumbs {
    display: flex;
    gap: 8px;
    font-size: 0.92rem;
    color: var(--ink-3);
  }

  .crumbs a {
    color: var(--ink-2);
  }

  h1 {
    font-size: clamp(2rem, 1.5rem + 2.4vw, 3.4rem);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }

  .pager a {
    display: grid;
    gap: 4px;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background: var(--card);
    font-weight: 600;
    text-decoration: none;
  }

  .pager a:hover {
    border-color: var(--ink-4);
  }

  .pager span {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .next {
    text-align: right;
  }

  @media (max-width: 600px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
