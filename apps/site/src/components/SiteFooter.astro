---
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();
const columns = [
  {
    title: "Product",
    links: [
      { href: "/features", label: "Features" },
      { href: "/pricing", label: "Pricing" },
      { href: "/use-cases", label: "Use cases" },
      { href: "/try", label: "Try it free" },
    ],
  },
  {
    title: "Help",
    links: [
      { href: "/help", label: "Help centre" },
      { href: "/join", label: "Join a session" },
      { href: "/contact", label: "Contact us" },
      { href: "/help/presenting-on-weak-wifi", label: "Weak Wi-Fi?" },
    ],
  },
  {
    title: "Company",
    links: [
      { href: "/about", label: "About" },
      { href: "/terms", label: "Terms" },
      { href: "/privacy", label: "Privacy" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="container grid">
    <div class="intro">
      <Wordmark tone="paper" />
      <p>Live polls, quizzes and Q&amp;A for rooms of every size, from a classroom to a conference hall.</p>
      <p class="made">Made in Nairobi.</p>
    </div>
    {
      columns.map((column) => (
        <nav aria-label={column.title}>
          <h2>{column.title}</h2>
          <ul>
            {column.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="container base">
    <p>© {year} Roomwave</p>
    <p>Prices are in Kenyan shillings.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--stage-line);
    background: var(--stage);
    background-image: var(--grain);
    color: var(--stage-muted);
    padding-top: clamp(48px, 7vw, 88px);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
    gap: 40px;
  }

  .intro p {
    max-width: 34ch;
    margin-top: 16px;
  }

  .made {
    color: var(--signal);
    font-weight: 600;
  }

  h2 {
    margin-bottom: 14px;
    font-family: var(--font-text);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--stage-text);
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--stage-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--stage-text);
    text-decoration: underline;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: 20px;
    padding-bottom: 28px;
    border-top: 1px solid var(--stage-line);
    font-size: 0.88rem;
  }

  @media (max-width: 860px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .intro {
      grid-column: 1 / -1;
    }
  }
</style>
