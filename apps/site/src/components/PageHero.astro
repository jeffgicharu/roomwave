---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  dark?: boolean;
  centred?: boolean;
}
const { eyebrow, title, lead, dark = false, centred = false } = Astro.props;
// Each sentence starts its own line, so two short sentences never run together on a phone.
const sentences = title.split(/(?<=[.?!])\s+(?=[A-Z])/);
---

<section class:list={["page-hero", { "stage-band": dark, centred }]}>
  <div class="container inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="h2">{sentences.map((sentence) => <span class="sentence">{sentence}</span>)}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  .page-hero {
    padding: clamp(56px, 8vw, 112px) 0 clamp(40px, 6vw, 72px);
    background: var(--paper);
    background-image: radial-gradient(50% 80% at 100% 0%, rgb(255 194 61 / 0.18), transparent 70%), var(--grain);
  }

  .page-hero.stage-band {
    background: var(--stage);
  }

  .inner {
    display: grid;
    gap: 18px;
  }

  .sentence {
    display: block;
    text-wrap: balance;
  }

  h1 {
    max-width: 18ch;
    font-size: clamp(2.4rem, 1.6rem + 3.6vw, 5rem);
    line-height: 0.98;
  }

  .centred .inner {
    justify-items: center;
    text-align: center;
  }

  .centred h1 {
    max-width: 20ch;
  }
</style>
